# Supabase Configuration (Required for live database, authentication, storage, and realtime)
# Find these in your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Optional: Configurable University Email Domain (can also be managed in platform_settings)
VITE_UNIVERSITY_EMAIL_DOMAIN="neu.ac.bd"
